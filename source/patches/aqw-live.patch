+/// AQW build (aqw-live): the local copy of an AQW game file, if there is one.
+///
+/// `https://game.aq.com/game/gamefiles/items/swords/sword01.swf?ver=1` is looked up as
+/// `aqw-overrides/items/swords/sword01.swf` next to the program (the query is ignored). Without
+/// that folder nothing changes. Only plain path parts are followed, so a URL can't reach a file
+/// outside the folder.
+fn aqw_override(url: &Url) -> Option<Vec<u8>> {
+    let host = url.host_str()?;
+    if host != "aq.com" && !host.ends_with(".aq.com") {
+        return None;
+    }
+    let path = url.path().strip_prefix("/game/gamefiles/")?;
+    let mut file = std::env::current_exe().ok()?.parent()?.join("aqw-overrides");
+    if !file.is_dir() {
+        return None;
+    }
+    for part in path.split('/') {
+        if part.is_empty() || part == "." || part == ".." || part.contains(['\\', ':']) {
+            return None;
+        }
+        file.push(part);
+    }
+    let contents = std::fs::read(&file).ok()?;
+    warn!("aqw-live: using {} instead of {url}", file.display());
+    Some(contents)
+}
