+/// AQW build (aqw-live): starts Mugetsu Studio, the item editor. The command is in
+/// `mugetsu-studio.txt` next to the program: the program on the first line, then one argument
+/// per line (no quoting needed), e.g. `pythonw` / `-I` / `C:\...\tools\studio.py`.
+pub fn open_studio() {
+    let Some(file) = std::env::current_exe()
+        .ok()
+        .and_then(|exe| exe.parent().map(|dir| dir.join("mugetsu-studio.txt")))
+    else {
+        return;
+    };
+    let Ok(text) = std::fs::read_to_string(&file) else {
+        let _ = rfd::MessageDialog::new()
+            .set_level(rfd::MessageLevel::Info)
+            .set_title("Mugetsu Studio")
+            .set_description(format!(
+                "To open Mugetsu Studio from here, put its command in {}: the program on the \
+                first line, then one argument per line.",
+                file.display()
+            ))
+            .set_buttons(rfd::MessageButtons::Ok)
+            .show();
+        return;
+    };
+    let mut lines = text.lines().map(str::trim).filter(|line| !line.is_empty());
+    let Some(program) = lines.next() else {
+        return;
+    };
+    if let Err(e) = std::process::Command::new(program).args(lines).spawn() {
+        tracing::warn!("Couldn't start Mugetsu Studio ({program}): {e}");
+    }
+}
